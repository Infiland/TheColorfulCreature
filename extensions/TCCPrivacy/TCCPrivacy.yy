  "gradleinject":"android {\n    // AAB packaging rejects APK ABI splits; Play generates the splits itself.\n    splits { abi { enable false } }\n    if (System.getenv(\"TCC_UPLOAD_KEYSTORE\")) {\n        signingConfigs.release {\n            storeFile file(System.getenv(\"TCC_UPLOAD_KEYSTORE\"))\n            storePassword System.getenv(\"TCC_UPLOAD_PASSWORD\")\n            keyAlias \"tcc-upload\"\n            keyPassword System.getenv(\"TCC_UPLOAD_PASSWORD\")\n        }\n    }\n}",
